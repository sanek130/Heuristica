NODE_ENV=development
PORT=5000
# В проде (единый сервис на Render) FRONTEND_URL = публичный URL этого же сервиса,
# VITE_API_URL оставляется пустым — фронтенд ходит в API того же origin.
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/heuristica?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
JWT_SECRET=change_this_to_a_random_string_at_least_32_characters
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key
ADMIN_EMAILS=yourgmail@gmail.com
